{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run seo:generate && npm run seo:verify",
    "lint": "eslint .",
    "seo:generate": "vite-node scripts/generate-seo-pages.mjs",
    "seo:verify": "vite-node scripts/verify-seo-pages.mjs",
    "asset:audit": "vite-node scripts/asset-audit.mjs",
    "showcase:export": "vite-node scripts/export-subject-visual-fixtures.mjs",
    "showcase:smoke": "vite-node scripts/render-showcase-smoke.mjs",
    "showcase:baseline": "vite-node scripts/showcase-baseline-report.mjs",
    "showcase:baseline:release": "SHOWCASE_BASELINE_REQUIRE_APPROVED=1 SHOWCASE_BASELINE_REFERENCE=../../eval/reports/subject-visual-showcase-approved-reference.json vite-node scripts/showcase-baseline-report.mjs",
    "showcase:review-packet": "vite-node scripts/showcase-review-packet.mjs",
    "showcase:approve-reference": "vite-node scripts/approve-showcase-reference.mjs",
    "template-previews:export": "vite-node --script scripts/export-template-preview-cases.mjs",
    "template-previews:posters": "node scripts/render-template-preview-posters.mjs",
    "test:visual:conics": "playwright test --config playwright.conics.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-charts": "^9.0.1",
    "@mui/x-data-grid": "^9.0.1",
    "@mui/x-tree-view": "^9.0.1",
    "@remotion/player": "4.0.462",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "dompurify": "^3.4.3",
    "katex": "^0.16.38",
    "mafs": "^0.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "remotion": "4.0.462",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@remotion/bundler": "4.0.462",
    "@remotion/cli": "4.0.462",
    "@remotion/renderer": "4.0.462",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.9.0",
    "msw": "^2.14.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vitest": "^2.1.9"
  }
}
