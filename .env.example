APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
APT_PIPELINE_DEPTH=0

# --- MetaView v2 Configuration (METAVIEW_ prefix) ---

METAVIEW_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|115\.191\.22\.22)(:\d+)?$
METAVIEW_DEFAULT_PROVIDER=
METAVIEW_DEFAULT_ROUTER_PROVIDER=
METAVIEW_DEFAULT_GENERATION_PROVIDER=
METAVIEW_APP_EDITION=self
METAVIEW_MOCK_PROVIDER_ENABLED=true
METAVIEW_MAX_REPAIR_ATTEMPTS=2
METAVIEW_HISTORY_DB_PATH=data/pipeline_runs.db

# Remotion playbook defaults (no hardcoding in code)
METAVIEW_PLAYBOOK_DEFAULT_FPS=30
METAVIEW_PLAYBOOK_DEFAULT_STEP_FRAMES=60
METAVIEW_PLAYBOOK_COMPOSITION_WIDTH=960
METAVIEW_PLAYBOOK_COMPOSITION_HEIGHT=540

# OpenAI-compatible provider
METAVIEW_OPENAI_API_KEY=
METAVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
METAVIEW_OPENAI_MODEL=
METAVIEW_OPENAI_SUPPORTS_VISION=false
METAVIEW_OPENAI_TIMEOUT_S=300
# CIR 长脚本 + 教学深度调参：默认 16000 留给长脚本不被截断；
# reasoning_effort 仅 gpt-5 / o-series 支持，其它服务商留空避免 400。
METAVIEW_OPENAI_MAX_TOKENS=16000
METAVIEW_OPENAI_REASONING_EFFORT=

# Generation pipeline mode. ``single`` keeps the legacy single-shot LLM →
# CIR JSON → PlaybookScript path. ``agent`` routes generation through the
# apps/agent Node sidecar (pi-agent-core + Drawing CLI).
METAVIEW_GENERATION_MODE=single
METAVIEW_AGENT_BASE_URL=http://agent:8001
METAVIEW_AGENT_TIMEOUT_S=600

# Account / recharge (only surfaced in VITE_APP_EDITION=ops)
METAVIEW_ACCOUNT_SESSION_COOKIE=mv_session
METAVIEW_ACCOUNT_SESSION_DAYS=30
METAVIEW_ACCOUNT_SESSION_SECURE=false
METAVIEW_RECHARGE_MIN_CENTS=500

# WeChat OAuth login (Website App / Open Platform)
METAVIEW_WECHAT_LOGIN_APPID=
METAVIEW_WECHAT_LOGIN_SECRET=
METAVIEW_WECHAT_LOGIN_REDIRECT_URI=
METAVIEW_WECHAT_LOGIN_SUCCESS_URL=http://127.0.0.1:5173/

# WeChat Pay API v3 Native recharge
METAVIEW_WECHAT_PAY_APPID=
METAVIEW_WECHAT_PAY_MCHID=
METAVIEW_WECHAT_PAY_MERCHANT_SERIAL_NO=
METAVIEW_WECHAT_PAY_PRIVATE_KEY_PATH=
METAVIEW_WECHAT_PAY_PRIVATE_KEY=
METAVIEW_WECHAT_PAY_API_V3_KEY=
METAVIEW_WECHAT_PAY_NOTIFY_URL=
METAVIEW_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
METAVIEW_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# apps/agent sidecar settings (only used when METAVIEW_GENERATION_MODE=agent).
AGENT_DEFAULT_PROVIDER=openai
AGENT_DEFAULT_MODEL=gpt-4o-mini
AGENT_API_BASE_URL=http://api:8000
AGENT_LOG_LEVEL=info

# Optional for production-like static deployment.
VITE_API_BASE_URL=
VITE_APP_EDITION=self
