APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
APT_PIPELINE_DEPTH=0
NPM_REGISTRY=https://registry.npmmirror.com

# --- MetaView v2 Configuration (METAVIEW_ prefix) ---

# Production: set your own HTTPS origin. Do not commit deployment IPs,
# private domains, or any secret values to this file.
METAVIEW_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
METAVIEW_DEFAULT_PROVIDER=
METAVIEW_DEFAULT_ROUTER_PROVIDER=
METAVIEW_DEFAULT_GENERATION_PROVIDER=
# self = local BYOK, no account/recharge/login UI. ops = WeChat-login SaaS.
# Keep this aligned with VITE_APP_EDITION.
METAVIEW_APP_EDITION=self
METAVIEW_MOCK_PROVIDER_ENABLED=true
METAVIEW_MAX_REPAIR_ATTEMPTS=2
METAVIEW_HISTORY_DB_PATH=data/pipeline_runs.db

# Remotion playbook defaults (no hardcoding in code)
METAVIEW_PLAYBOOK_DEFAULT_FPS=30
METAVIEW_PLAYBOOK_DEFAULT_STEP_FRAMES=60
METAVIEW_PLAYBOOK_COMPOSITION_WIDTH=960
METAVIEW_PLAYBOOK_COMPOSITION_HEIGHT=540

# OpenAI-compatible provider
METAVIEW_OPENAI_API_KEY=
METAVIEW_OPENAI_BASE_URL=https://api.openai.com/v1
METAVIEW_OPENAI_MODEL=
METAVIEW_OPENAI_CRITIC_MODEL=
METAVIEW_OPENAI_SUPPORTS_VISION=false
METAVIEW_OPENAI_TIMEOUT_S=300
# Local/dev agent demo often runs with no reviewer critic LLM; keep reviewer disabled.
METAVIEW_REVIEWER_MODE=off
# CIR 长脚本 + 教学深度调参：默认 16000 留给长脚本不被截断；
# reasoning_effort 仅 gpt-5 / o-series 支持，其它服务商留空避免 400。
METAVIEW_OPENAI_MAX_TOKENS=16000
METAVIEW_OPENAI_REASONING_EFFORT=

# Production review policy: configure METAVIEW_OPENAI_CRITIC_MODEL and keep
# reviewer mode as always / math_always to keep fail-closed on agent-mode output.

# Platform-managed TTS. In self edition the browser may pass temporary local
# TTS provider settings per request; in ops edition client TTS provider
# overrides are rejected and these server settings are used.
METAVIEW_TTS_API_KEY=
METAVIEW_TTS_BASE_URL=https://api.openai.com/v1
METAVIEW_TTS_MODEL=tts-1
METAVIEW_TTS_DEFAULT_VOICE=alloy
METAVIEW_TTS_TIMEOUT_S=60

# Small model router. ``hybrid`` tries model routing first and falls back to
# deterministic parsers / legacy topic routing when unavailable or uncertain.
METAVIEW_ROUTER_MODE=hybrid
METAVIEW_ROUTER_MODEL=
METAVIEW_ROUTER_TIMEOUT_S=12
METAVIEW_ROUTER_MIN_CONFIDENCE=0.72
METAVIEW_ROUTER_REFINE_CONFIDENCE=0.55
METAVIEW_ROUTER_TEMPERATURE=0

# Generation pipeline mode. ``single`` remains the legacy rollback/default path
# until agent parity passes. New runtime tools, SkillPacks, validators, and
# kernels should be exposed through the unified AgentPipeline / RuntimeToolHub.
# ``agent`` routes generation through provider adapters such as the apps/agent
# pi sidecar or Codex fallback.
METAVIEW_GENERATION_MODE=single
METAVIEW_AGENT_PROVIDER=http
METAVIEW_AGENT_BASE_URL=http://agent:8001
METAVIEW_AGENT_TIMEOUT_S=600
METAVIEW_AGENT_SHARED_TOKEN=
METAVIEW_CODEX_MODEL=gpt-5.5
METAVIEW_CODEX_EFFORT=
METAVIEW_CODEX_CWD=.
METAVIEW_AGENT_SKILLS_DIR=skills/metaview-agent

# Account / recharge (ops only; self does not create or require accounts)
METAVIEW_ACCOUNT_SESSION_COOKIE=mv_session
METAVIEW_ACCOUNT_SESSION_DAYS=30
METAVIEW_ACCOUNT_SESSION_SECURE=false
METAVIEW_RECHARGE_MIN_CENTS=500
METAVIEW_GENERATION_COST_CENTS=10

# WeChat OAuth login (Website App / Open Platform)
METAVIEW_WECHAT_LOGIN_APPID=
METAVIEW_WECHAT_LOGIN_SECRET=
METAVIEW_WECHAT_LOGIN_REDIRECT_URI=
METAVIEW_WECHAT_LOGIN_SUCCESS_URL=http://127.0.0.1:5173/

# WeChat Pay API v3 Native recharge (legacy/deprecated compatibility only;
# EasyPay is the main recharge path)
METAVIEW_WECHAT_PAY_APPID=
METAVIEW_WECHAT_PAY_MCHID=
METAVIEW_WECHAT_PAY_MERCHANT_SERIAL_NO=
METAVIEW_WECHAT_PAY_PRIVATE_KEY_PATH=
METAVIEW_WECHAT_PAY_PRIVATE_KEY=
METAVIEW_WECHAT_PAY_API_V3_KEY=
METAVIEW_WECHAT_PAY_NOTIFY_URL=
METAVIEW_WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
METAVIEW_WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
METAVIEW_WECHAT_NOTIFY_MAX_SKEW_S=300
METAVIEW_WECHAT_NOTIFY_REPLAY_TTL_S=600

# Payment gateway switch / EasyPay-compatible checkout (主路径)
# 主支付网关默认走 EasyPay，微信 APIv3 支付变量保留为 legacy/deprecated。
METAVIEW_PAYMENT_GATEWAY=easypay
# 兼容提示：主路径推荐使用 METAVIEW_EPAY_API_BASE + METAVIEW_EPAY_SUBMIT_PATH。
# 仅兼容旧部署场景，优先级低于主路径字段。
METAVIEW_EPAY_SUBMIT_URL=
METAVIEW_EPAY_API_BASE=
METAVIEW_EPAY_SUBMIT_PATH=/submit.php
METAVIEW_EPAY_PID=
METAVIEW_EPAY_KEY=
METAVIEW_EPAY_MERCHANT_ID=
METAVIEW_EPAY_API_KEY=
METAVIEW_EPAY_PAY_TYPE=wxpay
METAVIEW_EPAY_SIGN_TYPE=MD5
# 生产环境必填（建议 HTTPS，且为公网可达地址）
METAVIEW_EPAY_NOTIFY_URL=
# 生产环境必填（建议 HTTPS，且为公网可达地址，支持支付结果页跳转）
METAVIEW_EPAY_RETURN_URL=

# NewAPI redirect top-up bridge
METAVIEW_NEWAPI_TOPUP_INTENT_SECRET=
METAVIEW_NEWAPI_TOPUP_RECEIPT_TOKEN=
METAVIEW_NEWAPI_TOPUP_DEV_MODE=false
METAVIEW_NEWAPI_TOPUP_ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
METAVIEW_NEWAPI_QUOTA_PER_YUAN=500000

# apps/agent sidecar settings (only used when METAVIEW_GENERATION_MODE=agent).
AGENT_DEFAULT_PROVIDER=openai
AGENT_DEFAULT_MODEL=gpt-4o-mini
AGENT_API_BASE_URL=http://api:8000
AGENT_LOG_LEVEL=info

# Optional for production-like static deployment.
VITE_API_BASE_URL=
# Keep aligned with METAVIEW_APP_EDITION.
VITE_APP_EDITION=self
