      "requiredSemanticRoles": ["chord", "chord_midpoint", "locus_trail", "theoretical_locus"],
      "requiredStateFields": ["curves", "points", "segments"],
      "conclusionAliases": [["平行弦"], ["中点"], ["轨迹"], ["范围", "端点"]],
      "forbiddenAliases": ["所有截距都有效"]
    },
    {
      "caseId": "conic-hidden-pole-polar-01",
      "archetypeId": "conic.pole-polar.circle",
      "title": "圆的极点极线：非对角外点",
