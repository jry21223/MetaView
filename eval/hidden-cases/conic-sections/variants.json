      "requiredSemanticRoles": ["chord", "chord_midpoint", "locus_trail", "theoretical_locus"],
      "requiredStateFields": ["curves", "points", "segments"],
      "conclusionAliases": [["中点"], ["轨迹"], ["韦达", "点差法"], ["范围", "取值"]],
      "forbiddenAliases": ["随机移动"]
    },
    {
      "caseId": "conic-hidden-chord-locus-02",
      "archetypeId": "conic.ellipse.chord-midpoint-locus",
      "title": "平行弦族中点轨迹",
      "prompt": "在椭圆 x²/16+y²/4=1 中取斜率固定为 1/2 的平行弦族。展示各弦中点轨迹、有效截距范围和退化端点。",
      "parameters": {"a": 4, "b": 2, "slope": 0.5},
