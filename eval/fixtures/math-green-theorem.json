          "step": 0.25,
          "label": "F"
        },
        "segments": [
          { "x0": 0, "y0": 0, "x1": 1, "y1": 0, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 0, "x1": 1, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 1, "x1": 0, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 0, "y0": 1, "x1": 0, "y1": 0, "arrow": true, "emphasis": "primary" }
        ],
        "annotations": [
          { "x": 0.5, "y": 1.22, "text": "$\\oint_C Pdx+Qdy=1$", "align": "center" },
          { "x": 0.5, "y": -0.22, "text": "$\\iint_D 1\\,dA=1$", "align": "center" }
        ],
        "formula_latex": "\\oint_C P\\,dx+Q\\,dy=\\iint_D 1\\,dA=1",
        "caption": "边界一圈的总效果，等于内部所有局部旋转的总和。"
      }
    },
    {
      "step_id": "step_08",
      "end_frame": 1200,
      "title": "使用格林公式的检查清单",
      "voiceover_text": "使用格林公式时，先确认曲线闭合且正向，再确认区域足够规则，最后检查 P 和 Q 的偏导存在并连续。",
      "animation_hint": "enter",
      "snapshot": {
        "kind": "narration_card",
        "text": "记忆主线：边界环流 = 内部旋度总量。使用时先确认闭曲线、正向、P 和 Q 的偏导是否存在。",
        "position": "center",
        "emphasis": "accent"
      }
    }
  ],
