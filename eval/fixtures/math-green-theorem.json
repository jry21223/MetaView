  "domain": "math",
  "title": "格林公式讲解",
  "summary": "用动画讲解格林公式，说明边界线积分与区域旋度积分为什么相等，并用 F=(-y/2,x/2) 在单位正方形上验证。",
  "steps": [
    {
      "step_id": "step_01",
      "end_frame": 150,
      "title": "格林公式说什么",
      "voiceover_text": "格林公式连接两个看似不同的量：沿闭合边界走一圈得到的环流，和区域内部每一点的局部旋转密度总和。",
      "animation_hint": "enter",
      "snapshot": {
        "kind": "math_formula",
        "formula_latex": "\\oint_{\\partial D} P\\,dx+Q\\,dy=\\iint_D\\left(\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}\\right)\\,dA",
        "caption": "格林公式把边界上的环流转化为区域内部的旋度总和。",
        "highlights": [
          "\\oint_{\\partial D}",
          "\\iint_D",
          "\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}"
        ],
        "annotations": [
          "C=∂D 为正向闭曲线",
          "D 为平面区域"
        ]
      }
    },
    {
      "step_id": "step_02",
      "end_frame": 300,
      "title": "先确定区域和正向边界",
      "voiceover_text": "我们用单位正方形作为区域 D，边界 C 等于 D 的外边框。正向约定是逆时针行走，让区域始终在左手边。",
      "animation_hint": "draw",
      "snapshot": {
        "kind": "math_scene",
        "x_min": -0.35,
        "x_max": 1.35,
        "y_min": -0.35,
        "y_max": 1.35,
        "x_label": "x",
        "y_label": "y",
        "points": [
          { "x": 0, "y": 0, "label": "A", "emphasis": "primary" },
          { "x": 1, "y": 0, "label": "B", "emphasis": "primary" },
          { "x": 1, "y": 1, "label": "C", "emphasis": "primary" },
          { "x": 0, "y": 1, "label": "D", "emphasis": "primary" }
        ],
        "regions": [
          {
            "vertices": [[0, 0], [1, 0], [1, 1], [0, 1]],
            "label": "D",
            "emphasis": "secondary"
          }
        ],
        "segments": [
          { "x0": 0, "y0": 0, "x1": 1, "y1": 0, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 0, "x1": 1, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 1, "x1": 0, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 0, "y0": 1, "x1": 0, "y1": 0, "arrow": true, "emphasis": "primary" }
        ],
        "annotations": [
          { "x": 0.48, "y": 0.48, "text": "$D$", "align": "center" },
          { "x": 0.68, "y": 1.18, "text": "$\\partial D$", "align": "ne" },
          { "x": 0.12, "y": 1.18, "text": "正向边界", "align": "nw" }
        ],
        "formula_latex": "C=\\partial D",
        "caption": "正向边界表示沿区域外侧逆时针走一圈。"
      }
    },
    {
      "step_id": "step_03",
      "end_frame": 450,
      "title": "把向量场放进区域",
      "voiceover_text": "选择向量场 F 等于负二分之一 y、二分之一 x。箭头呈逆时针旋转，暗示区域内部存在稳定的局部环流。",
      "animation_hint": "draw",
      "snapshot": {
        "kind": "math_scene",
        "x_min": -0.45,
        "x_max": 1.45,
        "y_min": -0.45,
        "y_max": 1.45,
        "x_label": "x",
        "y_label": "y",
        "regions": [
          {
            "vertices": [[0, 0], [1, 0], [1, 1], [0, 1]],
            "label": "D",
            "emphasis": "secondary"
          }
        ],
        "vector_field": {
          "expression_px": "-0.5*y",
          "expression_py": "0.5*x",
          "step": 0.25,
          "label": "F"
        },
        "segments": [
          { "x0": 0, "y0": 0, "x1": 1, "y1": 0, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 0, "x1": 1, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 1, "x1": 0, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 0, "y0": 1, "x1": 0, "y1": 0, "arrow": true, "emphasis": "primary" }
        ],
        "annotations": [
          { "x": 0.22, "y": 1.22, "text": "$\\mathbf F=(-y/2,x/2)$", "align": "ne" },
          { "x": 0.5, "y": 0.52, "text": "$\\partial Q/\\partial x-\\partial P/\\partial y=1$", "align": "center" }
        ],
        "formula_latex": "\\mathbf F=(P,Q)=(-y/2,x/2)",
        "caption": "向量场在区域内持续逆时针旋转，旋度处处为 1。"
      }
    },
    {
      "step_id": "step_04",
      "end_frame": 600,
      "title": "左边：沿边界累加",
      "voiceover_text": "公式左边的线积分，只沿 C 这一条闭曲线计算。每一小段都取向量场在行走方向上的投影，再沿整圈累加。",
      "animation_hint": "enter",
      "snapshot": {
        "kind": "math_formula",
        "formula_latex": "\\oint_C P\\,dx+Q\\,dy",
        "caption": "左边沿边界 C 累加微小位移方向上的投影，表示一圈总环流。",
        "highlights": ["P\\,dx", "Q\\,dy"],
        "annotations": ["只看边界", "方向必须与正向一致"]
      }
    },
    {
      "step_id": "step_05",
      "end_frame": 750,
      "title": "右边：累加内部旋度",
      "voiceover_text": "公式右边不是看边界，而是把区域切成很多小面积。每个小块贡献一个旋度乘面积，最后把它们全部加起来。",
      "animation_hint": "draw",
      "snapshot": {
        "kind": "math_scene",
        "x_min": -0.35,
        "x_max": 1.35,
        "y_min": -0.35,
        "y_max": 1.35,
        "x_label": "x",
        "y_label": "y",
        "regions": [
          {
            "vertices": [[0, 0], [1, 0], [1, 1], [0, 1]],
            "label": "D",
            "emphasis": "secondary"
          },
          {
            "vertices": [[0.35, 0.35], [0.65, 0.35], [0.65, 0.65], [0.35, 0.65]],
            "label": "dA",
            "emphasis": "accent"
          }
        ],
        "vector_field": {
          "expression_px": "-0.5*y",
          "expression_py": "0.5*x",
          "step": 0.25,
          "label": "F"
        },
        "segments": [
          { "x0": 0, "y0": 0, "x1": 1, "y1": 0, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 0, "x1": 1, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 1, "y0": 1, "x1": 0, "y1": 1, "arrow": true, "emphasis": "primary" },
          { "x0": 0, "y0": 1, "x1": 0, "y1": 0, "arrow": true, "emphasis": "primary" }
        ],
        "annotations": [
          { "x": 0.5, "y": 0.72, "text": "$dA$", "align": "center" },
          { "x": 0.08, "y": -0.18, "text": "$\\mathrm{curl}\\,\\mathbf F=1$", "align": "ne" }
        ],
        "formula_latex": "\\iint_D \\mathrm{curl}\\,\\mathbf F\\,dA",
        "caption": "右边把每个小面积中的局部旋转密度加起来。"
      }
    },
    {
      "step_id": "step_06",
      "end_frame": 900,
      "title": "单位正方形上的验证",
      "voiceover_text": "在这个例子里，Q 对 x 的偏导是二分之一，P 对 y 的偏导是负二分之一，两者相减得到一，所以面积积分等于一。",
      "animation_hint": "enter",
      "snapshot": {
        "kind": "math_formula",
        "formula_latex": "P=-\\frac{y}{2},\\quad Q=\\frac{x}{2}\\quad\\Rightarrow\\quad\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y}=1",
        "caption": "在单位正方形上，面积积分就是 ∫∫D 1 dA = 1。",
        "highlights": [
          "\\frac{\\partial Q}{\\partial x}",
          "\\frac{\\partial P}{\\partial y}",
          "1"
        ],
        "annotations": ["例子选得简单：旋度恒定", "D 的面积为 1"]
      }
    },
    {
      "step_id": "step_07",
      "end_frame": 1050,
      "title": "结论：边界等于内部",
      "voiceover_text": "最终，边界线积分等于一，内部旋度积分也等于一。格林公式告诉我们，可以在边界计算和区域计算之间自由转换。",
      "animation_hint": "draw",
      "snapshot": {
        "kind": "math_scene",
