{
  "name": "metaview",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/agent",
    "apps/mcp-server"
  ],
  "overrides": {
    "flatted": "^3.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.462",
    "@remotion/bundler": "4.0.462",
    "@remotion/cli": "4.0.462",
    "@remotion/renderer": "4.0.462",
    "@remotion/player": "4.0.462"
  },
  "scripts": {
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "asset:audit": "npm --workspace apps/web run asset:audit",
    "test:mcp": "npm --workspace apps/mcp-server run test",
    "mcp:stdio": "npm --workspace apps/mcp-server run start",
    "setup:git-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4"
  }
}
